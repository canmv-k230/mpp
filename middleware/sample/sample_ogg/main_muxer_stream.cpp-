#include <iostream>
#include <cstring>
#include <unistd.h>
#include <pthread.h>
#include "libogg.h"
#include "mpi_ai_api.h"
#include "mpi_aenc_api.h"
#include "mpi_sys_api.h"
#include "mpi_vb_api.h"

using namespace std;

// Global control flag
static k_bool g_audio_running = K_FALSE;

// Ogg muxer instance
static kd_ogg_muxer g_ogg_muxer = NULL;

// Audio device and channel parameters
#define AI_DEV_NUM 0
#define AI_CHN_NUM 0
#define AENC_CHN_NUM 0
#define SAMPLE_RATE 16000
#define BIT_WIDTH KD_AUDIO_BIT_WIDTH_16
#define AUDIO_PERSEC_DIV_NUM 50

int ogg_write_callback(const void *ptr, size_t size, void *user_data) {
    size_t total_bytes = size;
    // 示例：打印长度（实际应替换为你的流输出逻辑）
    printf("[Ogg Stream] Writing %zu bytes\n", total_bytes);

    // 示例1: 写入标准输出（可用于管道测试）
    // fwrite(ptr, 1, total_bytes, stdout);
    // fflush(stdout);

    // 示例2: 写入内存缓冲（需自行管理线程安全）
    // YourStreamBuffer::GetInstance()->Write((const uint8_t*)ptr, total_bytes);

    // 示例3: 通过 socket 发送（伪代码）
    // send(your_socket_fd, ptr, total_bytes, MSG_NOSIGNAL);

    // 此处仅为演示，返回成功
    return (int)total_bytes; // 必须返回实际写入字节数
}

static k_s32 audio_sample_vb_init() {
    k_s32 ret;
    k_vb_config config;
    memset(&config, 0, sizeof(config));
    config.max_pool_cnt = 64;
    ret = kd_mpi_vb_set_config(&config);
    if (ret) {
        printf("vb_set_config failed, ret: %d\n", ret);
        return ret;
    } else {
        printf("vb_set_config succeeded\n");
    }
    ret = kd_mpi_vb_init();
    if (ret)
        printf("vb_init failed, ret: %d\n", ret);
    return ret;
}

// Process encoded data and write to Ogg stream
static void handle_encoded_data(k_audio_stream *stream) {
    if (!g_ogg_muxer || !stream)
        return;

    k_u8 *raw_data = (k_u8 *)kd_mpi_sys_mmap(stream->phys_addr, stream->len);

    kd_ogg_frame_params frame_params;
    frame_params.data = raw_data;
    frame_params.len = stream->len;
    frame_params.frame_samples = SAMPLE_RATE / AUDIO_PERSEC_DIV_NUM;

    int ret = kd_ogg_write_frame(g_ogg_muxer, &frame_params);
    if (ret != 0) {
        cerr << "Failed to write Ogg frame: " << ret << endl;
    }

    kd_mpi_sys_munmap(raw_data, stream->len);
}

static void *audio_process_thread(void *arg) {
    k_aio_dev_attr ai_dev_attr;
    memset(&ai_dev_attr, 0, sizeof(ai_dev_attr));
    ai_dev_attr.audio_type = KD_AUDIO_INPUT_TYPE_I2S;
    ai_dev_attr.kd_audio_attr.i2s_attr.sample_rate = SAMPLE_RATE;
    ai_dev_attr.kd_audio_attr.i2s_attr.bit_width = BIT_WIDTH;
    ai_dev_attr.kd_audio_attr.i2s_attr.chn_cnt = 2;
    ai_dev_attr.kd_audio_attr.i2s_attr.i2s_mode = K_STANDARD_MODE;
    ai_dev_attr.kd_audio_attr.i2s_attr.snd_mode = KD_AUDIO_SOUND_MODE_MONO;
    ai_dev_attr.kd_audio_attr.i2s_attr.frame_num = AUDIO_PERSEC_DIV_NUM;
    ai_dev_attr.kd_audio_attr.i2s_attr.point_num_per_frame = SAMPLE_RATE / AUDIO_PERSEC_DIV_NUM;
    ai_dev_attr.kd_audio_attr.i2s_attr.i2s_type = K_AIO_I2STYPE_INNERCODEC;

    if (K_SUCCESS != kd_mpi_ai_set_pub_attr(AI_DEV_NUM, &ai_dev_attr)) {
        cerr << "Failed to set AI device attributes" << endl;
        return NULL;
    }

    k_aenc_chn_attr aenc_chn_attr;
    memset(&aenc_chn_attr, 0, sizeof(aenc_chn_attr));
    aenc_chn_attr.type = K_PT_OPUS;
    aenc_chn_attr.buf_size = AUDIO_PERSEC_DIV_NUM;
    aenc_chn_attr.sample_rate = SAMPLE_RATE;
    aenc_chn_attr.channels = 1;
    aenc_chn_attr.bitrate = 16000;
    aenc_chn_attr.point_num_per_frame = SAMPLE_RATE / AUDIO_PERSEC_DIV_NUM;

    if (0 != kd_mpi_aenc_create_chn(AENC_CHN_NUM, &aenc_chn_attr)) {
        cerr << "Failed to create encoder channel" << endl;
        return NULL;
    }

    k_mpp_chn ai_mpp_chn, aenc_mpp_chn;
    ai_mpp_chn.mod_id = K_ID_AI;
    ai_mpp_chn.dev_id = AI_DEV_NUM;
    ai_mpp_chn.chn_id = AI_CHN_NUM;
    aenc_mpp_chn.mod_id = K_ID_AENC;
    aenc_mpp_chn.dev_id = 0;
    aenc_mpp_chn.chn_id = AENC_CHN_NUM;

    if (0 != kd_mpi_sys_bind(&ai_mpp_chn, &aenc_mpp_chn)) {
        cerr << "Failed to bind AI and encoder" << endl;
        kd_mpi_aenc_destroy_chn(AENC_CHN_NUM);
        return NULL;
    }

    k_ai_vqe_enable vqe_enable;
    memset(&vqe_enable, 0, sizeof(k_ai_vqe_enable));
    vqe_enable.ans_enable = K_TRUE;
    if (K_SUCCESS != kd_mpi_ai_set_vqe_attr(AI_DEV_NUM, AI_CHN_NUM, vqe_enable)) {
        printf("kd_mpi_ai_set_vqe_attr failed\n");
        return NULL;
    }

    kd_mpi_ai_enable(AI_DEV_NUM);
    kd_mpi_ai_enable_chn(AI_DEV_NUM, AI_CHN_NUM);

    k_audio_stream audio_stream;
    g_audio_running = K_TRUE;
    cout << "Start capturing and encoding audio (streaming mode)..." << endl;
    while (g_audio_running) {
        if (K_SUCCESS == kd_mpi_aenc_get_stream(AENC_CHN_NUM, &audio_stream, 100)) {
            handle_encoded_data(&audio_stream);
            kd_mpi_aenc_release_stream(AENC_CHN_NUM, &audio_stream);
        }
    }

    kd_mpi_sys_unbind(&ai_mpp_chn, &aenc_mpp_chn);
    kd_mpi_ai_disable_chn(AI_DEV_NUM, AI_CHN_NUM);
    kd_mpi_ai_disable(AI_DEV_NUM);
    kd_mpi_aenc_destroy_chn(AENC_CHN_NUM);
    cout << "Audio processing thread exited" << endl;
    return NULL;
}

int main(int argc, char *argv[]) {
    pthread_t audio_thread;

    audio_sample_vb_init();

    // === 使用流式初始化
    kd_ogg_muxer_params muxer_params;
    // filename 字段忽略
    memset(muxer_params.filename, 0, sizeof(muxer_params.filename));
    muxer_params.sample_rate = SAMPLE_RATE;
    muxer_params.channels = 1;
    muxer_params.serial_no = 0;

    // 调用流式初始化
    int ret = kd_ogg_muxer_init_stream(&g_ogg_muxer, &muxer_params, ogg_write_callback, nullptr);
    if (ret != 0) {
        cerr << "Failed to initialize Ogg stream muxer: " << ret << endl;
        return -1;
    }
    cout << "Ogg stream muxer initialized successfully." << endl;

    if (pthread_create(&audio_thread, NULL, audio_process_thread, NULL) != 0) {
        cerr << "Failed to create audio processing thread" << endl;
        kd_ogg_muxer_destroy(g_ogg_muxer);
        return -1;
    }

    cout << "Streaming audio... Press any key to stop." << endl;
    getchar();

    g_audio_running = K_FALSE;
    pthread_join(audio_thread, NULL);
    kd_ogg_muxer_destroy(g_ogg_muxer); // 会 flush 剩余数据并写 EOS
    kd_mpi_vb_exit();
    cout << "Streaming finished." << endl;
    return 0;
}